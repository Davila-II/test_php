# ==============================================================================
# Configuration d'environnement — DjoKhouse SCI
# ==============================================================================

# Connexion PostgreSQL (Supabase) - Obligatoire en production sur Vercel
# Format: postgresql://[USER]:[PASSWORD]@[HOST]:[PORT]/[DATABASE]
# Exemple (Supabase direct ou session pooler port 5432 / 6543):
SUPABASE_DB_URL=postgresql://postgres.your-ref:your-db-password@aws-0-eu-central-1.pooler.supabase.com:6543/postgres

# API Supabase & Storage (pour l'upload des photos de terrains/projets)
SUPABASE_URL=https://your-ref.supabase.co
SUPABASE_SERVICE_KEY=your-supabase-service-role-key-here

# Clé secrète de sécurité pour la signature des sessions Vercel (HMAC-SHA256)
# Générez une clé aléatoire complexe (ex: openssl rand -hex 32)
APP_SECRET=your-random-32-characters-secret-key-here
